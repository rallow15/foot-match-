# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma sqlite db
/prisma/dev.db
/prisma/dev.db-journal

# uploaded licences (private, served via authenticated API route)
/data/uploads/

# legacy public uploads dir (no longer used)
/public/uploads/*

# vercel
.vercel

# fichiers d'agents/skills auto-générés (tooling local, pas du code applicatif)
/.agents
/skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

# claude local plans / agent artifacts
/.claude
/claude-plans
*.claude.md.bak

# local debloat tooling workspace
/tv-debloat/

# python cache
__pycache__/
*.pyc
