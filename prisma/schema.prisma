// Prisma schema — Plateforme de matchs amicaux entre clubs amateurs
// Postgres (Supabase) en production ET en dev (mêmes migrations).
// Note: pas d'enums natifs utilisés — les valeurs sont validées dans le code
// (src/lib/referential.ts), ce qui garde le schéma portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Club {
  id                   String     @id @default(cuid())
  nom                  String
  ville                String
  codePostal           String
  latitude             Float
  longitude            Float
  ligue                String   // Ligue régionale FFF (ex. "Auvergne-Rhône-Alpes")
  district             String   // District / sous-ligue FFF (ex. "Lyon-Rhône")
  telephone            String
  email                String     @unique
  logoUrl              String?
  licenceFichierUrl    String?
  // en_attente | valide | refuse
  statutVerification   String     @default("en_attente")
  // reason text shown to club when refused
  refusMotif           String?
  passwordHash         String
  // distinguishes a platform admin from a regular club
  role                 String     @default("club") // club | admin
  // Anti brute-force login : compteur d'échecs + verrou temporaire. L'état est
  // en base (pas en mémoire), donc il survit aux redémarrages et aux instances
  // multiples — complète rate-limit.ts qui reste mono-instance.
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  derniereActiviteAt   DateTime   @default(now())
  createdAt            DateTime   @default(now())

  equipes              Equipe[]
  sessions             Session[]
  annonces             Annonce[]   @relation("AnnoncePar")
  contactsEmis         ContactLog[] @relation("Demandeur")
  contactsRecus        ContactLog[] @relation("Destinataire")
  messages             Message[]    @relation("AuteurMessage")
  passwordResetTokens  PasswordResetToken[]

  @@index([statutVerification])
  @@index([email])
}

model Equipe {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  // referential: see CATEGORIES in src/lib/referential.ts
  categorie String
  // nullable: see NIVEAUX_BY_CATEGORIE
  niveau    String?

  annonces  Annonce[]

  @@index([clubId])
  @@index([categorie])
}

model Annonce {
  id              String   @id @default(cuid())
  equipeId        String
  equipe          Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  clubId          String
  club            Club     @relation("AnnoncePar", fields: [clubId], references: [id], onDelete: Cascade)
  // ISO date yyyy-mm-dd
  date            String
  // HH:mm or plage "14:00-16:00"
  heure           String
  // domicile | exterieur | indifferent
  domicileExterieur String
  stadeDispo      Boolean  @default(false)
  stadeNom        String?
  stadeVille      String?
  arbitreDispo    Boolean  @default(false)
  niveauSouhaite  String?
  note            String?
  // ouvert | confirme | annule
  statut          String   @default("ouvert")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts        ContactLog[]
  matchResult     MatchResult?

  @@index([equipeId])
  @@index([clubId])
  @@index([statut])
  @@index([date])
}

model MatchResult {
  id              String   @id @default(cuid())
  annonceId       String   @unique
  annonce         Annonce  @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  adversaireNom   String?
  scoreDomicile   Int?
  scoreExterieur  Int?
  commentaire     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([annonceId])
}

model Session {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  // Hash SHA-256 du token (le cookie porte le token clair, la base n'en stocke
  // que le hash : une fuite de base ne permet pas de détournement de session).
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([clubId])
}

model ContactLog {
  id              String     @id @default(cuid())
  annonceId       String
  annonce         Annonce    @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  demandeurClubId String
  demandeur       Club       @relation("Demandeur", fields: [demandeurClubId], references: [id], onDelete: Cascade)
  destinataireId  String
  destinataire    Club       @relation("Destinataire", fields: [destinataireId], references: [id], onDelete: Cascade)
  // Message initial de la mise en relation (conservé pour compatibilité ; les
  // réponses sont stockées dans Message).
  message         String?
  // Dernier message lu par le demandeur / destinataire (pour les badges non-lus).
  demandeurReadAt DateTime?
  destinataireReadAt DateTime?
  // contact shown to demandeur after request
  createdAt       DateTime   @default(now())

  messages        Message[]

  @@index([annonceId])
  @@index([demandeurClubId])
  @@index([destinataireId])
  // Idempotence de la mise en relation : un même demandeur ne contacte une
  // annonce qu'une fois. Atomicité au niveau base (anti race + anti
  // email-bombing : pas de renvoi de notification sur re-demande).
  @@unique([demandeurClubId, annonceId])
}

model Message {
  id            String     @id @default(cuid())
  contactLogId  String
  contactLog    ContactLog @relation(fields: [contactLogId], references: [id], onDelete: Cascade)
  auteurClubId  String
  auteur        Club       @relation("AuteurMessage", fields: [auteurClubId], references: [id], onDelete: Cascade)
  contenu       String
  createdAt     DateTime   @default(now())

  @@index([contactLogId])
  @@index([auteurClubId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  // Hash SHA-256 du token (le lien email porte le token clair, la base n'en
  // stocke que le hash : une fuite de base ne permet pas de réinitialiser un mot
  // de passe). Même stratégie que Session.tokenHash.
  tokenHash String   @unique
  expiresAt DateTime              // now + 15 min
  // Marqué à la consommation (usage unique) ; null tant que non utilisé.
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([clubId])
}

// Compteur de rate limiting par IP, partagé entre instances (Postgres).
// Remplace le Map in-memory qui n'était valable qu'en mono-instance : sur
// Fluid Compute / serverless, chaque instance aurait eu son propre compteur et
// un attaquant répartissant ses requêtes aurait contourné les seuils.
model RateLimit {
  id        String   @id @default(cuid())
  // Clé = `${action}:${ip}` — un compteur par action et par IP.
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())

  // Nettoyage périodique des fenêtres expirées.
  @@index([resetAt])
}