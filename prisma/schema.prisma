generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Club {
  id                  String               @id @default(cuid())
  nom                 String
  ville               String
  codePostal          String
  latitude            Float
  longitude           Float
  ligue               String
  district            String
  telephone           String
  email               String               @unique
  logoUrl             String?
  licenceFichierUrl   String?
  statutVerification  String               @default("en_attente")
  refusMotif          String?
  passwordHash        String?
  role                String               @default("club")
  derniereActiviteAt  DateTime             @default(now())
  createdAt           DateTime             @default(now())
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  oauthName           String?
  oauthPicture        String?
  oauthProvider       String?
  oauthProviderId     String?
  description         String?              @db.VarChar(1000)
  onboardingSeenAt    DateTime?
  siteWeb             String?
  departement         String?
  alertes             Alerte[]
  annonces            Annonce[]            @relation("AnnoncePar")
  avisDonnes          Avis[]               @relation("AvisAuteur")
  avisRecus           Avis[]               @relation("AvisCible")
  equipes             Equipe[]
  favoris             Favori[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  signalements        Signalement[]

  @@unique([oauthProvider, oauthProviderId])
  @@index([statutVerification])
  @@index([email])
  @@index([ligue, district])
  @@index([departement])
  @@index([statutVerification, role])
}

model Equipe {
  id        String    @id @default(cuid())
  clubId    String
  categorie String
  niveau    String?
  annonces  Annonce[]
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([categorie])
  @@index([categorie, niveau])
}

model Annonce {
  id                String    @id @default(cuid())
  equipeId          String
  clubId            String
  date              String
  heure             String
  domicileExterieur String
  stadeDispo        Boolean   @default(false)
  stadeNom          String?
  stadeVille        String?
  arbitreDispo      Boolean   @default(false)
  niveauSouhaite    String?
  note              String?
  statut            String    @default("ouvert")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  adversaireNom     String?
  avisEmailSentAt   DateTime?
  club              Club      @relation("AnnoncePar", fields: [clubId], references: [id], onDelete: Cascade)
  equipe            Equipe    @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@index([equipeId])
  @@index([clubId])
  @@index([statut])
  @@index([date])
  @@index([statut, date])
  @@index([statut, date, clubId])
}

model Session {
  id        String   @id @default(cuid())
  clubId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  clubId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([resetAt])
}

model Favori {
  id        String   @id @default(cuid())
  clubId    String
  type      String
  cibleId   String
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, type, cibleId])
  @@index([clubId])
  @@index([cibleId])
}

model Signalement {
  id        String   @id @default(cuid())
  annonceId String
  clubId    String
  motif     String   @db.VarChar(500)
  statut    String   @default("ouvert")
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([annonceId])
  @@index([clubId])
  @@index([statut])
}

model Avis {
  id           String   @id @default(cuid())
  annonceId    String
  auteurClubId String
  cibleClubId  String
  note         Int
  commentaire  String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  auteurClub   Club     @relation("AvisAuteur", fields: [auteurClubId], references: [id], onDelete: Cascade)
  cibleClub    Club     @relation("AvisCible", fields: [cibleClubId], references: [id], onDelete: Cascade)

  @@unique([annonceId, auteurClubId])
  @@index([annonceId])
  @@index([auteurClubId])
  @@index([cibleClubId])
}

model Alerte {
  id          String    @id @default(cuid())
  clubId      String
  categorie   String?
  ligue       String?
  district    String?
  rayonKm     Int?
  centreLat   Float?
  centreLng   Float?
  lastSentAt  DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  departement String?
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([active])
  @@index([active, lastSentAt])
}
