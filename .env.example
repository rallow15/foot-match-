# ============================================================
# Configuration — copier ce fichier en .env et remplir les valeurs.
# .env est gitignoré (ne jamais committer de secrets).
# ============================================================

# Environnement
NODE_ENV=production
APP_URL=https://ton-domaine.fr

# ---- Base de données (Postgres Supabase) ----
# Supabase > Database > "Connect" > "Direct connection" (port 5432).
# Utiliser la connexion DIRECTE (recommandée pour Prisma), pas le pooler
# transactionnel. Format :
# postgresql://postgres.[REF]:[MOT_DE_PASSE]@db.[REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres.[REF]:[MOT_DE_PASSE]@db.[REF].supabase.co:5432/postgres"

# ---- Supabase Storage (uploads logos + licences) ----
# Supabase > Project Settings > API.
# Project URL, ex. https://xxxxx.supabase.co
SUPABASE_URL=https://xxxxx.supabase.co
# service_role key — CONFIDENTIEL, usage serveur uniquement (jamais côté client).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin ----
# OBLIGATOIRE en production : le seed échoue sans cette variable.
ADMIN_EMAIL=admin@ton-domaine.fr
ADMIN_PASSWORD=choisir-un-mdp-long-et-fort

# ---- Email (optionnel) ----
# Sans SMTP_HOST, les notifications de contact sont loggées dans la console
# serveur (fallback) — l'application fonctionne, mais pas d'envoi réel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Matchs Amicaux <no-reply@ton-domaine.fr>"